# Postgres en Neon. Usar la connection string con pooling (-pooler) para
# que las funciones serverless de Vercel no agoten las conexiones.
DATABASE_URL="postgresql://usuario:password@host-pooler.region.aws.neon.tech/clasificados?sslmode=require"

# Token de Vercel Blob para las fotos de los avisos.
# Misma base pero sin el pooler. Solo la usan las migraciones.
DIRECT_DATABASE_URL="postgresql://usuario:password@host.region.aws.neon.tech/clasificados?sslmode=require"

BLOB_READ_WRITE_TOKEN=""

# Secreto para firmar la cookie de sesión. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
